# Build output
website/dist/

# Dependencies (none expected — the build is zero-dependency; guard anyway)
node_modules/

# Environment & secrets — never commit credentials
.env
.env.*
*.pem

# Zoho Catalyst local artifacts
.catalyst/
.catalystrc
catalyst-debug.log

# CI analyzer artifacts (run locally to reproduce the CI gates — never committed)
.lighthouseci/
.npm-cache/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json
.claude/settings.json
.claude/launch.json

# OS / editor noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# CRM data exports — CONTAIN STUDENT PII (names, emails, phones, case history).
# Never commit. Backups belong in encrypted off-machine storage, not in git:
# git history is permanent, widely cloned, and cannot be selectively redacted.
# See docs/31 for where they should live instead.
backups/
