# Build output
website/dist/

# Dependencies (none expected — the build is zero-dependency; guard anyway)
node_modules/

# Environment & secrets — never commit credentials
.env
.env.*
!.env.example
*.pem

# Zoho Catalyst local artifacts
.catalyst/
catalyst-debug.log

# Local Claude Code settings (machine-specific)
.claude/settings.local.json
.claude/launch.json
# Nested git worktrees. These are full checkouts of OTHER branches living inside
# this one; committing one would drop an unrelated branch's tree onto this branch.
.claude/worktrees/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Local token cache (secrets — never commit)
.cache/

# Catalyst build artifacts (regenerated by functions/catalyst/build.mjs)
functions/catalyst/dist/

# Lighthouse CI run artifacts (regenerated by every `lhci autorun`)
.lighthouseci/

# Integration-test workspace (real PostgreSQL binaries + driver)
db/test/node_modules/
