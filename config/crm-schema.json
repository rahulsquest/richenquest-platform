          "<10L",
          "10-20L",
          "20-35L",
          "35L+"
        ]
      },
      {
        "label": "Preferred Language",
        "type": "picklist",
        "values": [
          "English",
          "Hindi",
          "Nepali",
          "Other"
        ]
      },
      {
        "label": "WhatsApp Number",
        "type": "phone"
      },
      {
        "label": "UTM Source",
        "type": "text",
        "length": 120
      },
      {
        "label": "UTM Medium",
        "type": "text",
        "length": 120
      },
      {
        "label": "UTM Campaign",
        "type": "text",
        "length": 120
      }
    ],
    "Deals": [
      {
        "label": "Destination Country",
        "type": "picklist",
        "values_from": "destinations"
      },
      {
        "label": "Course & University Final",
        "type": "text",
        "length": 255
      },
      {
        "label": "Assigned Counselor",
        "type": "userlookup",
        "manual": true,
        "manual_reason": "user-lookup field creation is unreliable via API"
      },
      {
        "label": "Service Package",
        "type": "picklist",
        "values_from": "service_packages"
      },
      {
        "label": "Document Status",
        "type": "picklist",
        "values": [
          "Not Started",
          "Collecting",
          "APS Applied",
          "APS Received",
          "AI Pre-checked",
          "Verified",
          "Complete"
        ]
      },
      {
        "label": "Lane",
        "type": "picklist",
        "values": [
          "Commission (Private)",
          "Service-fee (Public)",
          "n/a"
        ]
      },
      {
        "label": "Visa Status",
        "type": "picklist",
        "values": [
          "N/A",
          "Preparing",
