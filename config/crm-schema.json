      {
        "label": "Campus List",
        "type": "text",
        "length": 255,
        "_note": "Comma-separated; split into a list by collaboration.mjs institutionView(). NOT named 'Campuses': Zoho rejects that label as reserved (INVALID_REQUEST on field creation, verified against the live org 2026-07-26). API name: Campus_List."
      },
      {
        "label": "International Office Contact",
        "type": "text",
        "length": 128
      },
      {
        "label": "International Office Email",
