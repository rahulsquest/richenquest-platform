# ─────────────────────────────────────────────────────────────────────────────
# RichenQuest — Zoho environment template.
# Copy to `.env` (which is gitignored) and fill in. NEVER commit real values.
#   cp .env.example .env
# Local use:      node --env-file=.env functions/zoho/scripts/verify.mjs
# Production:     set these as Catalyst environment variables (not a file).
# ─────────────────────────────────────────────────────────────────────────────

# Data centre where you created the API-console app. India = "in" (RichenQuest default).
# api-console.zoho.in → in · .com → us · .eu → eu · .com.au → au · .jp → jp · zohocloud.ca → ca
ZOHO_DC=in

# ── OAuth application credentials (Zoho API Console → your "rahulsquest" app) ──
# Client ID is low-sensitivity; Client Secret is a SECRET — keep both out of git.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# The EXACT Redirect URI configured on the app (must match character-for-character).
ZOHO_REDIRECT_URI=

# Space-separated OAuth scopes requested during authorization (auth-url.mjs).
# Start least-privilege: CRM leads is all the launch funnel needs. Add more only
# as each server-side feature is built. Verify exact strings against Zoho's
# current scope reference (they drift) — see docs/14 §11.
#   CRM only:   ZohoCRM.modules.ALL,ZohoCRM.settings.ALL
#   + Mail:     ...,ZohoMail.messages.CREATE
#   + Bookings: ...,zohobookings.data.CREATE,zohobookings.data.READ
ZOHO_SCOPES=ZohoCRM.modules.ALL,ZohoCRM.settings.ALL

# ── Long-lived token (produced by exchange-code.mjs; SECRET) ─────────────────
ZOHO_REFRESH_TOKEN=

# Optional: share ONE access token across CLI processes instead of each one
# spending a refresh. Zoho rate-limits refreshes per 10-minute window, and
# repeated CLI runs will otherwise trip "Access Denied". The file holds a live
# access token — keep it gitignored (.cache/ already is). Unset = in-memory only.
ZOHO_TOKEN_CACHE_FILE=.cache/zoho-token.json

# ── Per-service extras (only needed when that service's client is used) ──────
# Zoho Mail: the sending account id (Mail → Settings → account details).
ZOHO_MAIL_ACCOUNT_ID=
# Zoho Analytics: your org id (Analytics → Settings).
ZOHO_ANALYTICS_ORG_ID=
# Zoho SalesIQ: portal screen name (from your SalesIQ URL).
ZOHO_SALESIQ_SCREENNAME=
# Zoho Flow: an incoming-webhook URL to trigger a flow (capability-bearing; not OAuth).
ZOHO_FLOW_WEBHOOK_URL=

# ── Event-driven automation (ADR-006) ────────────────────────────────────────
# Public HTTPS endpoint that Zoho CRM pushes record events to (the Catalyst
# function). Required by provision-notifications.mjs; also needs the
# ZohoCRM.notifications.ALL scope. Leave empty until Catalyst exists.
ZOHO_NOTIFY_URL=

# Secret for the per-channel webhook auth token: each channel's callback token
# is HMAC(secret, channel_id), so a forged notification cannot guess it. Set the
# SAME value here and as a Catalyst function env var. Generate with:
#   openssl rand -hex 32
TITAN_WEBHOOK_SECRET=

# CRM user id that the automation writes run as — powers the loop-breaker
# (records last modified by this user are skipped). Set after user provisioning.
TITAN_AUTOMATION_USER_ID=

# ═════════════════════════════════════════════════════════════════════════════
# PLATFORM — Career Record + Operations. Added for Internal Release v1.
# Set these as Catalyst environment variables in production, never in a file.
# ═════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL (Neon) ────────────────────────────────────────────────────────
# The ONLY system of record. Minimum major 16; tested against 18.4.
# Neon: Project -> Connection Details -> "Pooled connection" string.
# sslmode=require is not optional — this carries personal data.
#   postgres://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
DATABASE_URL=

# Optional pool tuning. Neon's pooler already multiplexes; keep PG_POOL_MAX
# modest or the pooler and the app both queue.
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=10000

# Set false to run `node db/migrate.mjs up` as a separate deploy step instead of
# on boot. Recommended once more than one instance runs.
RUN_MIGRATIONS_ON_START=true

# ── Session signing ──────────────────────────────────────────────────────────
# >=32 bytes, random. THE SAME secret for both APIs — that is what makes one
# login serve the Career Record and the Operations console.
#   openssl rand -hex 32
RECORD_TOKEN_SECRET=

# ── Vault key provider ───────────────────────────────────────────────────────
# `env` is REFUSED when NODE_ENV=production. Production must be `kms`.
RECORD_VAULT_PROVIDER=env
# Development only: 32 random bytes, base64. Ignored when the provider is kms.
#   openssl rand -base64 32
RECORD_VAULT_KEK=
RECORD_VAULT_KEK_VERSION=v1

# ── Google Cloud KMS (production key provider) ───────────────────────────────
# Service account needs roles/cloudkms.cryptoKeyEncrypterDecrypter on the key —
# and nothing more. It can wrap and unwrap; it cannot read, disable or destroy.
# Authentication is Application Default Credentials.
GCP_PROJECT_ID=
GCP_KMS_LOCATION=asia-south1
GCP_KMS_KEYRING=
GCP_KMS_KEY=
# Older key versions, so a rotation can still unwrap what they wrapped:
# GCP_KMS_KEY_V1=vault-kek-v1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins. EMPTY IS REFUSED in production: an API holding
# personal data must name its callers. Include the site AND the console origin.
CORS_ALLOWED_ORIGINS=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
