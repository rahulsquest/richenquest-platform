# ─────────────────────────────────────────────────────────────────────────────
# RichenQuest — Zoho environment template.
# Copy to `.env` (which is gitignored) and fill in. NEVER commit real values.
#   cp .env.example .env
# Local use:      node --env-file=.env functions/zoho/scripts/verify.mjs
# Production:     set these as Catalyst environment variables (not a file).
# ─────────────────────────────────────────────────────────────────────────────

# Data centre where you created the API-console app. India = "in" (RichenQuest default).
# api-console.zoho.in → in · .com → us · .eu → eu · .com.au → au · .jp → jp · zohocloud.ca → ca
ZOHO_DC=in

# ── OAuth application credentials (Zoho API Console → your "rahulsquest" app) ──
# Client ID is low-sensitivity; Client Secret is a SECRET — keep both out of git.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# The EXACT Redirect URI configured on the app (must match character-for-character).
ZOHO_REDIRECT_URI=

# Space-separated OAuth scopes requested during authorization (auth-url.mjs).
# Start least-privilege: CRM leads is all the launch funnel needs. Add more only
# as each server-side feature is built. Verify exact strings against Zoho's
# current scope reference (they drift) — see docs/14 §11.
#   CRM only:   ZohoCRM.modules.ALL,ZohoCRM.settings.ALL
#   + Mail:     ...,ZohoMail.messages.CREATE
#   + Bookings: ...,zohobookings.data.CREATE,zohobookings.data.READ
ZOHO_SCOPES=ZohoCRM.modules.ALL,ZohoCRM.settings.ALL

# ── Long-lived token (produced by exchange-code.mjs; SECRET) ─────────────────
ZOHO_REFRESH_TOKEN=

# Optional: share ONE access token across CLI processes instead of each one
# spending a refresh. Zoho rate-limits refreshes per 10-minute window, and
# repeated CLI runs will otherwise trip "Access Denied". The file holds a live
# access token — keep it gitignored (.cache/ already is). Unset = in-memory only.
ZOHO_TOKEN_CACHE_FILE=.cache/zoho-token.json

# ── Per-service extras (only needed when that service's client is used) ──────
# Zoho Mail: the sending account id (Mail → Settings → account details).
ZOHO_MAIL_ACCOUNT_ID=
# Zoho Analytics: your org id (Analytics → Settings).
ZOHO_ANALYTICS_ORG_ID=
# Zoho SalesIQ: portal screen name (from your SalesIQ URL).
ZOHO_SALESIQ_SCREENNAME=
# Zoho Flow: an incoming-webhook URL to trigger a flow (capability-bearing; not OAuth).
ZOHO_FLOW_WEBHOOK_URL=

# ── Event-driven automation (ADR-006) ────────────────────────────────────────
# Public HTTPS endpoint that Zoho CRM pushes record events to (the Catalyst
# function). Required by provision-notifications.mjs; also needs the
# ZohoCRM.notifications.ALL scope. Leave empty until Catalyst exists.
ZOHO_NOTIFY_URL=
