void scheduler.schedNightlySweep()
{
	/*  PURPOSE
	 *    Thin scheduler wrapper. Runs the nightly partnership sweep.
	 *
	 *    Schedules will not accept a `standalone` function - the function must
	 *    be category `scheduler` (verified 2026-08-16: standalone ids return
	 *    "The function id given seems to be invalid"). So this exists purely to
	 *    be schedulable, and delegates immediately so the business logic stays
	 *    in one place.
	 *
	 *  OWNER    platform
	 *  DEPENDS  archiveExpiredPartnership
	 *  VERSION  1.0 (2026-08-16)
	 */
	result = standalone.archiveExpiredPartnership();
	info "nightly sweep: " + result;
}
