string standalone.caseState(string case_id)
{
	/*  CORE ENGINE v1.0 — FROZEN. See CORE-ENGINE.md.
	 *
	 *  PURPOSE
	 *    The state engine. Every other surface — student360, buildWorkQueue,
	 *    dashboards, the parent PDF, the portal — derives from this. Nothing
	 *    else decides risk, priority, next action, blockers or eligibility.
	 *
	 *    It answers five questions and nothing else:
	 *      1. What state is this case in?
	 *      2. What is blocking it?
	 *      3. What is the next IRREVERSIBLE milestone?
	 *      4. What evidence supports that?
	 *      5. What happens if we do nothing?
	 *
	 *  READ-ONLY, AND THAT IS LOAD-BEARING
	 *    This function is called on every dashboard render, every queue build,
	 *    every PDF. If it wrote anything, opening a student eleven times would
	 *    write eleven rows and the audit timeline would be worthless exactly
	 *    when it mattered. Transitions are appended by recordStateEvent, which
	 *    compares against the last snapshot and writes only on change.
	 *
	 *  HARD BLOCKS ARE STATE, NOT SCORE
	 *    v1.0 floored severity-1 blockers to a score of 15. That was still
	 *    arithmetic, so a later tweak to the formula could silently un-float
	 *    them. Some conditions must ALWAYS dominate however distant the
	 *    deadline is, because what makes them urgent is how long they take to
	 *    clear, not when they are due. Those set hard_block, and the band
	 *    becomes HIGH with no arithmetic involved.
	 *
	 *  EVERY VERDICT CARRIES ITS REASONING
	 *    A blocker is never a string. It is {code, hard_block, blocking,
	 *    because[], evidence{}, consequence}. When somebody asks "why did the
	 *    system tell me to do this?", the answer is already in the payload
	 *    rather than in the head of whoever wrote the rule.
	 *
	 *  KNOWN GAP
	 *    "Payment legally required before submission" is a declared hard block
	 *    with nothing to read — no payment field exists at case level, and
	 *    inventing one would be worse than the gap. FOUNDER DECISION REQUIRED:
	 *    which countries or universities require payment before submission,
	 *    and where that state should live. Recorded in CORE-ENGINE.md.
	 *
	 *  DEPENDENCIES  none
	 *  VERSION       2.0 (2026-08-17)
	 */
	out = Map();
	if(case_id == null || case_id.trim() == "")
	{
		out.put("ok",false);
		out.put("error","case_id required");
		return out.toString();
	}
	d = zoho.crm.getRecordById("Deals",case_id.toLong());
	if(d.get("id") == null)
	{
		out.put("ok",false);
		out.put("error","case not found: " + case_id);
		return out.toString();
	}
	today = zoho.currentdate;
	stage = d.get("Stage");
	journey = d.get("Student_Journey_Stage");
	risk = d.get("Visa_Ops_Risk");
	docs = d.get("Document_Status");
	passport = d.get("Passport_Status");
	appt = d.get("Visa_Appointment_Status");
	visa_dec = d.get("Visa_Decision");
	permit = d.get("Residence_Permit_Status");
	nd = d.get("Next_Deadline");
	start = d.get("Course_Start_Date");
	refusal = d.get("Refusal_Grounds");
	days_left = -999;
	has_deadline = false;
	if(nd != null && nd != "")
	{
		days_left = days360(today,nd.toString().subString(0,10).toDate());
		has_deadline = true;
	}
	/*  Consent lives on the Contact, not the Deal — one person consents once,
	 *  and that consent has to survive across every case they ever open.
	 */
	consent = false;
	consent_known = false;
	cn = d.get("Contact_Name");
	if(cn != null && cn.get("id") != null)
	{
		c = zoho.crm.getRecordById("Contacts",cn.get("id").toLong());
		if(c.get("id") != null)
		{
			consent_known = true;
			if(c.get("Consent_Given") == true)
			{
				consent = true;
			}
		}
	}
	/*  1. STATE — one canonical value, derived. Never stored, so it can never
	 *  disagree with the fields it is derived from.
	 */
	state = "COUNSELLING";
	if(stage == "Closed Lost")
	{
		state = "CLOSED_LOST";
	}
	else if(journey == "Alumni" || journey == "Success Story")
	{
		state = "ALUMNI";
	}
	else if(journey == "Enrolled" || journey == "Arrived")
	{
		state = "SETTLING";
	}
	else if(journey == "Pre-Departure" || journey == "Accommodation Confirmed")
	{
		state = "PRE_DEPARTURE";
	}
	else if(visa_dec == "Approved")
	{
		state = "VISA_APPROVED";
	}
	else if(visa_dec == "Refused")
	{
		state = "VISA_REFUSED";
	}
	else if(appt == "Attended" || stage == "Visa Filed")
	{
		state = "AWAITING_VISA_DECISION";
	}
	else if(appt == "Slot Booked" || appt == "Awaiting Slot")
	{
		state = "VISA_PREP";
	}
	else if(stage == "Offer Received")
	{
		state = "OFFER_IN_HAND";
	}
	else if(stage == "Applications Submitted")
	{
		state = "AWAITING_OFFER";
	}
	else if(stage == "Documents in Progress")
	{
		state = "COLLECTING_DOCUMENTS";
	}
	else if(stage == "New Inquiry" || stage == "Counseling Booked")
	{
		state = "QUALIFYING";
	}
	out.put("state",state);
	/*  2. BLOCKERS. List order IS the ranking: hard blocks first, worst first.
	 *  buildWorkQueue and student360 both take element 0 as the thing to do.
	 */
	blockers = List();
	if(visa_dec == "Refused" && (refusal == null || refusal == ""))
	{
		b = Map();
		b.put("code","REFUSAL_NOT_RECORDED");
		b.put("hard_block",true);
		b.put("blocking","Everything. The appeal decision cannot be made without the grounds");
		b.put("because",{"Visa_Decision is Refused","Refusal_Grounds is empty"});
		e = Map();
		e.put("Visa_Decision",visa_dec);
		b.put("evidence",e);
		b.put("consequence","The grounds are lost permanently. We cannot advise on appeal, cannot classify it as curable or substantive, and cannot add it to the refusal log that every future student benefits from");
		blockers.add(b);
	}
	if(consent_known && !consent)
	{
		b2 = Map();
		b2.put("code","CONSENT_MISSING");
		b2.put("hard_block",true);
		b2.put("blocking","Any submission of this student's data to a university or a mission");
		b2.put("because",{"Contact.Consent_Given is not true","DPDP requires demonstrable consent before personal data is processed or shared"});
		e2 = Map();
		e2.put("Consent_Given",false);
		b2.put("evidence",e2);
		b2.put("consequence","Sending documents onward without recorded consent is a legal exposure no commercial outcome justifies, and it cannot be cured retrospectively — consent obtained afterwards does not cover what was already sent");
		blockers.add(b2);
	}
	if(passport == null || passport == "" || passport == "Not applied" || passport == "Expired")
	{
		b3 = Map();
		b3.put("code","NO_PASSPORT");
		b3.put("hard_block",true);
		b3.put("blocking","Application submission, visa appointment, everything downstream");
		b3.put("because",{"Passport_Status is '" + passport + "'","A visa cannot be issued into a passport that does not exist"});
		e3 = Map();
		e3.put("Passport_Status",passport);
		b3.put("evidence",e3);
		b3.put("consequence","A new Indian passport takes weeks. Every day of delay comes straight off the intake, and no other work compensates for it");
		blockers.add(b3);
	}
	if(risk == "Red")
	{
		b4 = Map();
		b4.put("code","TIMING_LOST");
		b4.put("hard_block",true);
		b4.put("blocking","The intake itself");
		b4.put("because",{"Visa_Ops_Risk is Red","The last safe visa filing date computed by visaOpsPlan is behind us"});
		e4 = Map();
		e4.put("Visa_Ops_Risk",risk);
		e4.put("Course_Start_Date",start);
		b4.put("evidence",e4);
		b4.put("consequence","Continuing to work this intake sells a family a start date they cannot reach. That is the single most damaging thing this business can do, and it gets worse the longer nobody says it out loud");
		blockers.add(b4);
	}
	if(appt == "Slot Booked" && docs != "Complete" && docs != "Verified")
	{
		b5 = Map();
		b5.put("code","APPOINTMENT_WITHOUT_DOCUMENTS");
		b5.put("hard_block",true);
		b5.put("blocking","A successful submission");
		b5.put("because",{"Appointment is booked","Document_Status is '" + docs + "'","SOP-1's checklist gate was skipped"});
		e5 = Map();
		e5.put("Document_Status",docs);
		e5.put("Visa_Appointment_Status",appt);
		b5.put("evidence",e5);
		b5.put("consequence","A counter rejection costs the SLOT, not the day. The next available appointment may be past the last safe filing date");
		blockers.add(b5);
	}
	/*  A passed application deadline is read from Applications, not the Deal.
	 *  Submitted_On is the test rather than a status picklist, because an empty
	 *  submission date stays unambiguous however the statuses get renamed.
	 */
	apps = zoho.crm.searchRecords("Applications","(Student_Case:equals:" + case_id + ")");
	missed = List();
	if(apps != null)
	{
		for each a in apps
		{
			ad = a.get("Application_Deadline");
			so = a.get("Submitted_On");
			if(ad != null && ad != "" && (so == null || so == ""))
			{
				if(days360(today,ad.toString().subString(0,10).toDate()) < 0)
				{
					missed.add(a.get("University") + " — deadline " + ad + ", never submitted");
				}
			}
		}
	}
	if(missed.size() > 0)
	{
		b6 = Map();
		b6.put("code","DEADLINE_PASSED");
		b6.put("hard_block",true);
		b6.put("blocking","Those applications, permanently");
		b6.put("because",missed);
		e6 = Map();
		e6.put("missed_count",missed.size());
		b6.put("evidence",e6);
		b6.put("consequence","These cannot be recovered by working harder. Either alternatives are found for this intake, or the family is told the truth about the timeline today while there is still a next intake to plan for");
		blockers.add(b6);
	}
	/*  Soft blockers — real, but scored rather than dominant. */
	if(risk == "Not computed" || risk == null)
	{
		s1 = Map();
		s1.put("code","NO_START_DATE");
		s1.put("hard_block",false);
		s1.put("blocking","All backward planning");
		s1.put("because",{"Course_Start_Date is empty","visaOpsPlan cannot compute a last safe filing date without an anchor"});
		s1.put("consequence","Every deadline on this case is invisible. The nightly sweep will keep reporting it as unplannable and no alert will ever fire");
		s1.put("severity",2);
		blockers.add(s1);
	}
	if(appt == "Awaiting Slot")
	{
		s2 = Map();
		s2.put("code","AWAITING_SLOT");
		s2.put("hard_block",false);
		s2.put("blocking","Visa filing");
		s2.put("because",{"No mission in the portfolio publishes an appointment API","This requires a human to check a portal"});
		s2.put("consequence","Slots are not monitored by anything. If nobody checks, nobody knows one opened");
		s2.put("severity",2);
		blockers.add(s2);
	}
	if(docs != "Complete" && docs != "Verified" && state != "QUALIFYING")
	{
		s3 = Map();
		s3.put("code","DOCUMENTS_INCOMPLETE");
		s3.put("hard_block",false);
		s3.put("blocking","Application submission");
		s3.put("because",{"Document_Status is '" + docs + "'"});
		s3.put("consequence","Document collection is the predicted failure point of this pipeline. Families that say yes in September and cannot produce papers by October miss the intake");
		s3.put("severity",3);
		blockers.add(s3);
	}
	out.put("blockers",blockers);
	out.put("blocked",blockers.size() > 0);
	/*  3. NEXT IRREVERSIBLE MILESTONE. */
	mile = Map();
	if(state == "SETTLING" && permit != "Card Issued")
	{
		mile.put("milestone","Residence permit filing window");
		mile.put("irreversible","Yes — Italy 8 days from arrival, Hungary 30, Malta 3 months. A legal deadline, not an administrative one");
		mile.put("if_we_do_nothing","The student's legal right to remain lapses. This is not recoverable by apologising to a university");
	}
	else if(has_deadline)
	{
		mile.put("milestone","Next deadline on the case");
		mile.put("date",nd);
		mile.put("days_remaining",days_left);
		if(risk == "Red")
		{
			mile.put("irreversible","ALREADY PASSED — the last safe visa filing date is behind us");
			mile.put("if_we_do_nothing","The intake is lost. Continuing to work it sells a family a start date they cannot reach");
		}
		else
		{
			mile.put("irreversible","Yes — an application deadline and a visa filing date cannot be extended by us");
			mile.put("if_we_do_nothing","The student waits a full intake cycle. For a February applicant that is roughly seven months");
		}
	}
	else
	{
		mile.put("milestone","None computable");
		mile.put("irreversible","Unknown");
		mile.put("if_we_do_nothing","Nothing will alert anybody, because there is no date to alert against. This is itself the risk");
	}
	out.put("next_irreversible",mile);
	/*  4. EVIDENCE — the exact fields every verdict above was derived from, so
	 *  a disagreement can be settled by looking rather than by arguing.
	 */
	ev = Map();
	ev.put("Stage",stage);
	ev.put("Student_Journey_Stage",journey);
	ev.put("Visa_Ops_Risk",risk);
	ev.put("Document_Status",docs);
	ev.put("Passport_Status",passport);
	ev.put("Visa_Appointment_Status",appt);
	ev.put("Visa_Decision",visa_dec);
	ev.put("Course_Start_Date",start);
	ev.put("Next_Deadline",nd);
	ev.put("Consent_Given",consent);
	out.put("evidence",ev);
	/*  5. BAND FIRST, THEN SCORE.
	 *
	 *  The band is a decision, not a number. Any hard block puts the case in
	 *  HIGH regardless of arithmetic. The formula runs only when nothing is
	 *  hard-blocked, and then it only orders cases WITHIN a band.
	 */
	hard = List();
	sev = 5;
	for each bb in blockers
	{
		if(bb.get("hard_block") == true)
		{
			hard.add(bb.get("code"));
		}
		else if(bb.get("severity") != null && bb.get("severity") < sev)
		{
			sev = bb.get("severity");
		}
	}
	urgency = 1;
	if(risk == "Red")
	{
		urgency = 5;
	}
	else if(risk == "Amber")
	{
		urgency = 3;
	}
	else if(has_deadline && days_left < 21 && days_left >= 0)
	{
		urgency = 4;
	}
	else if(has_deadline && days_left < 45 && days_left >= 0)
	{
		urgency = 2;
	}
	score = (6 - sev) * urgency;
	band = "LOW";
	basis = "No hard block. (6 - worst severity " + sev + ") x urgency " + urgency + " = " + score;
	if(hard.size() > 0)
	{
		band = "HIGH";
		score = 100 + hard.size() * 10 + urgency;
		basis = "HARD BLOCK — " + hard.toString(", ") + ". Banded HIGH as a state, not a score: these take longer to clear than any deadline gives you, so they cannot wait for urgency to rise";
	}
	else if(score >= 12)
	{
		band = "MEDIUM";
	}
	out.put("band",band);
	out.put("hard_blocks",hard);
	out.put("priority_score",score);
	out.put("priority_basis",basis);
	out.put("case_id",case_id);
	out.put("student",d.get("Deal_Name"));
	out.put("owner",d.get("Assigned_Counselor"));
	out.put("country",d.get("Destination_Country"));
	out.put("stage",stage);
	out.put("modified",d.get("Modified_Time"));
	out.put("computed_at",zoho.currenttime.toString("yyyy-MM-dd HH:mm:ss"));
	out.put("ok",true);
	return out.toString();
}
