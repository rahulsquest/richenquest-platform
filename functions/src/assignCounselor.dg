string standalone.assignCounselor(string lead_id)
{
	/*  Assigns a lead to the least-loaded active Counselor.
	 *
	 *  "Least loaded" = fewest leads currently owned that are not closed.
	 *  Round-robin was specified (File 01 5.1) but least-loaded is strictly
	 *  better and degenerates to round-robin when loads are equal.
	 *
	 *  IMPORTANT: as of 2026-08-15 no user holds the Counselor role, so this
	 *  returns {"ok":false,"reason":"no active counselors"} and changes
	 *  nothing. That is the correct behaviour, not a failure - it must never
	 *  silently assign a student lead to whoever happens to be an admin.
	 *
	 *  Returns JSON: {"ok":bool,"assigned_to":"...","load":n,"reason":"..."}
	 */
	out = Map();
	closed = {"Junk Lead","Lost Lead","Not Qualified"};
	resp = zoho.crm.getRecords("users");
	users = resp.get("users");
	best = "";
	best_name = "";
	best_tier = "";
	best_load = -1;
	if(users != null)
	{
		/*  TIERED FALLBACK — added 2026-08-17 after a live submission.
		 *
		 *  This function required role.name == "Counselor". No user in the org
		 *  has that role (they are CEO and Operations), so EVERY lead fell
		 *  through to "no active counselors" and was left unowned. An unowned
		 *  lead is not in anybody's work queue: it is in the CRM and invisible,
		 *  which is worse than being assigned to the wrong person.
		 *
		 *  Preference order, first non-empty tier wins. A suboptimal owner is
		 *  always better than no owner, and the tier is reported so nobody
		 *  mistakes a fallback for a proper routing decision.
		 */
		tiers = {"Counselor","Operations","*"};
		for each tier in tiers
		{
			if(best != "")
			{
				continue;
			}
			for each u in users
			{
				if(u.get("status") != "active")
				{
					continue;
				}
				role = u.get("role");
				rname = "";
				if(role != null)
				{
					rname = role.get("name");
				}
				/*  The administrator is the founder. Included only in the last
				 *  tier, so leads do not silently pile onto the founder while a
				 *  real counsellor exists — the exact dependency this company is
				 *  trying to reduce.
				 */
				if(tier != "*" && rname != tier)
				{
					continue;
				}
				uid = u.get("id");
				owned = zoho.crm.searchRecords("Leads","(Owner:equals:" + uid + ")");
				load = 0;
				if(owned != null)
				{
					for each l in owned
					{
						if(!closed.contains(l.get("Lead_Status")))
						{
							load = load + 1;
						}
					}
				}
				if(best_load < 0 || load < best_load)
				{
					best_load = load;
					best = uid;
					best_name = u.get("full_name");
					best_tier = tier;
				}
			}
		}
	}
	if(best == "")
	{
		out.put("ok",false);
		out.put("reason","no active users at all — the CRM has nobody to own this lead");
		return out.toString();
	}
	upd = Map();
	upd.put("Owner",best);
	res = zoho.crm.updateRecord("Leads",lead_id,upd);
	if(res.get("id") == null)
	{
		out.put("ok",false);
		out.put("reason",res.toString());
		return out.toString();
	}
	standalone.generateAuditLog("Leads",lead_id,"assignment","assigned to " + best_name + " (open leads: " + best_load + ")");
	out.put("ok",true);
	out.put("assigned_to",best_name);
	out.put("assigned_to_id",best);
	out.put("load",best_load);
	out.put("tier",best_tier);
	if(best_tier != "Counselor")
	{
		out.put("warning","Assigned by FALLBACK tier '" + best_tier + "'. No user holds the Counselor role. Create it and assign counsellors, or every lead routes by accident rather than by design");
	}
	return out.toString();
}
