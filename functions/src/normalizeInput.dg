string standalone.normalizeInput(string field, string value)
{
	/*  PURPOSE
	 *    The single normalisation layer. Every integration that writes to a
	 *    picklist goes through here - the WhatsApp parser, the web form, any
	 *    future import, API or mobile app.
	 *
	 *  WHY IT EXISTS
	 *    Zoho does NOT enforce picklist values. Verified 2026-08-17: a probe
	 *    wrote "Masters" into Interested_Level, whose only valid value is
	 *    "Master's". The record saved with no error and no warning.
	 *
	 *    That is the most dangerous class of bug in this system, because
	 *    leadToPlan matches the exact string - so the lead can never be planned
	 *    and NOTHING IN THE RECORD LOOKS WRONG. A counsellor sees "Masters" and
	 *    cannot understand why the matcher errors.
	 *
	 *    Scattering normalisation across parseInquiry, leadToPlan and every
	 *    future integration would guarantee they drift. One function, one place
	 *    to fix when a picklist changes.
	 *
	 *  CONTRACT
	 *    Returns the canonical CRM value, or the trimmed input unchanged when
	 *    the field is not one it governs. NEVER returns empty for a non-empty
	 *    input - silently blanking a value is worse than passing it through,
	 *    because a wrong value is visible and a missing one is not.
	 *
	 *  VERSION  1.1 (2026-08-17) — numeric and income fields added
	 */
	if(value == null)
	{
		return "";
	}
	v = value.trim();
	if(v == "" || v == "-")
	{
		return "";
	}
	/*  Curly apostrophes survive copy-paste through WhatsApp and phone
	 *  keyboards, and they are invisible in a CRM field.
	 */
	v = v.replaceAll("’","'");
	v = v.replaceAll("‘","'");
	lower = v.toLowerCase();
	if(field == "Interested_Level")
	{
		if(lower.startsWith("master") || lower == "pg" || lower == "ms" || lower == "msc")
		{
			return "Master's";
		}
		if(lower.startsWith("bachelor") || lower == "ug" || lower == "bsc" || lower == "ba")
		{
			return "Bachelor's";
		}
		if(lower.startsWith("diploma"))
		{
			return "Diploma";
		}
		if(lower.startsWith("phd") || lower.startsWith("doctor"))
		{
			return "PhD";
		}
		return "Other";
	}
	if(field == "English_Status")
	{
		if(lower.contains("no test") || lower.contains("none") || lower.contains("toefl") || lower.contains("pte"))
		{
			return "None";
		}
		if(lower.contains("moi") || lower.contains("medium of instruction") || lower.contains("taught in english"))
		{
			return "MOI";
		}
		if(v.contains("5.5"))
		{
			return "5.5";
		}
		if(v.contains("6.0") || v == "6")
		{
			return "6.0";
		}
		if(v.contains("6.5"))
		{
			return "6.5";
		}
		if(v.contains("7"))
		{
			return "7.0";
		}
		return "None";
	}
	if(field == "Passport_Status")
	{
		if(lower.contains("valid") || lower.contains("have"))
		{
			return "Valid";
		}
		if(lower.contains("applied") && !lower.contains("not"))
		{
			return "Applied";
		}
		if(lower.contains("expired"))
		{
			return "Expired";
		}
		return "Not applied";
	}
	if(field == "Budget_Range")
	{
		if(lower.contains("<10") || lower.contains("under 10") || lower.contains("under ₹10"))
		{
			return "<10L";
		}
		if(v.contains("35") && (lower.contains("+") || lower.contains("above")))
		{
			return "35L+";
		}
		if(v.contains("20") && v.contains("35"))
		{
			return "20-35L";
		}
		if(v.contains("10") && v.contains("20"))
		{
			return "10-20L";
		}
		return v;
	}
	/*  NUMERIC FIELDS.
	 *
	 *  Added 2026-08-17 after the first wizard submission failed outright:
	 *  Academic_Percentage is a DOUBLE and the form sent "72%", so the whole
	 *  Lead create was rejected. Four more fields have the same shape.
	 *
	 *  This is a louder failure than the picklist one — the record is refused
	 *  rather than silently saved wrong — but the cause is identical, so the
	 *  cure belongs in the same place. A human writing "1 year" or "none" in a
	 *  WhatsApp message must never be able to reject a real enquiry.
	 *
	 *  SCALE IS NEVER GUESSED. "7.4" is a CGPA and "72" is a percentage, and
	 *  the multiplier between them differs by university. This returns the
	 *  number as given and parseInquiry keeps the original string in the
	 *  Description, so nobody has to reconstruct what the family actually wrote.
	 */
	if(field == "Academic_Percentage" || field == "Work_Experience_Years")
	{
		num = "";
		seen_dot = false;
		for each ch in v.toList("")
		{
			if("0123456789".contains(ch))
			{
				num = num + ch;
			}
			else if(ch == "." && !seen_dot && num != "")
			{
				num = num + ch;
				seen_dot = true;
			}
		}
		if(num == "" || num == ".")
		{
			return "";
		}
		return num;
	}
	if(field == "Backlogs" || field == "Study_Gap_Years")
	{
		if(lower.contains("none") || lower.contains("nil") || lower == "no")
		{
			return "0";
		}
		num2 = "";
		for each ch2 in v.toList("")
		{
			if("0123456789".contains(ch2))
			{
				num2 = num2 + ch2;
			}
		}
		if(num2 == "")
		{
			return "";
		}
		return num2;
	}
	if(field == "Parents_Annual_Income")
	{
		/*  A picklist, not free text — the wizard was sending "12 lakh", which
		 *  Zoho would have saved silently and no report would ever have matched.
		 */
		if(lower.contains("not stated") || lower.contains("prefer not"))
		{
			return "Not stated";
		}
		amt = "";
		for each ch3 in v.toList("")
		{
			if("0123456789".contains(ch3))
			{
				amt = amt + ch3;
			}
		}
		if(amt == "")
		{
			return "Not stated";
		}
		n = amt.toLong();
		/*  A figure above 1000 was almost certainly typed in rupees rather than
		 *  lakh ("1200000"), so it is converted rather than banded as "Above 35L".
		 */
		if(n > 1000)
		{
			n = n / 100000;
		}
		if(n < 5)
		{
			return "Under 5L";
		}
		if(n < 10)
		{
			return "5-10L";
		}
		if(n < 20)
		{
			return "10-20L";
		}
		if(n <= 35)
		{
			return "20-35L";
		}
		return "Above 35L";
	}
	if(field == "Intended_Intake")
	{
		if(lower.startsWith("feb"))
		{
			return "Feb 2027";
		}
		if(lower.startsWith("mar"))
		{
			return "Mar 2027";
		}
		if(lower.startsWith("sep") && v.contains("2026"))
		{
			return "Sep 2026";
		}
		if(lower.startsWith("sep"))
		{
			return "Sep 2027";
		}
		if(lower.startsWith("jan"))
		{
			return "Jan 2027";
		}
		if(lower.startsWith("may"))
		{
			return "May 2027";
		}
		if(v.contains("2028"))
		{
			return "2028+";
		}
		if(lower.contains("not sure") || lower.contains("undecided"))
		{
			return "Undecided";
		}
		return v;
	}
	/*  Not a field this function governs. Pass through unchanged rather than
	 *  guessing - an unknown field is not the same as a bad value.
	 */
	return v;
}
